// If you want the app to switch icon/splash by system theme (requires
// expo-splash-screen config plugin for the splash part; adaptiveIcon
// itself has no built-in light/dark switch in Expo — see note below):
{
  "expo": {
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D",
      "dark": {
        "image": "./assets/splash.png",
        "backgroundColor": "#0D0D0D"
      },
      "light": {
        "image": "./assets/splash_light.png",
        "backgroundColor": "#ECE5D2"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
