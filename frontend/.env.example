# CampusRide Frontend Environment Configuration

# Backend API Base URL
# For Physical Android / iOS device testing: Set to your development laptop's local LAN IP (e.g. http://192.168.1.100:5000)
# For Android Emulator: http://10.0.2.2:5000
# For iOS Simulator / Web: http://localhost:5000
EXPO_PUBLIC_API_URL=http://192.168.13.5:5000

# Native development-build-only MapLibre validation screen.
# Leave false to run the existing Expo Go application.
EXPO_PUBLIC_MAPLIBRE_SPIKE=false

# Development-Only OTP Verification Bypass (true / false)
# TODO(CAMPUSRIDE-AUTH): TEMPORARY DEV-ONLY OTP BYPASS
EXPO_PUBLIC_AUTH_DEV_BYPASS=true

# Optional single-device defense demo mode. Keep false for normal physical GPS.
EXPO_PUBLIC_DEFENSE_SIMULATION=false
