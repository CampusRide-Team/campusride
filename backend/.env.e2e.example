# CampusRide Phase 2.5 - Dedicated E2E Test Environment Template
# Copy this file to .env.e2e (which is git-ignored) for running E2E tests against an isolated database.

PORT=5000
NODE_ENV=test

# Isolated E2E MongoDB database (DO NOT point to shared staging/production)
MONGO_URI=mongodb://127.0.0.1:27017/campusride_e2e

# Dedicated E2E JWT Secret
JWT_SECRET=campusride_e2e_secret_key_2026
