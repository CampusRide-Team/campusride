PORT=5000
MONGO_URI=your_mongodb_uri
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=CampusRide/1.0 (contact: replace-with-project-contact)
JWT_SECRET=your_jwt_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional primary road-routing provider. Keep this secret on the backend.
# Without it, CampusRide uses the public OSRM demo service best-effort, then a labeled geodesic estimate.
ORS_API_KEY=your_openrouteservice_api_key
ROUTING_TIMEOUT_MS=7000
ROUTING_CACHE_TTL_MS=300000
ROUTING_CACHE_MAX_ENTRIES=100
